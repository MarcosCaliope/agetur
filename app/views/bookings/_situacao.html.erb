<%# Where a booked tour stands. locals: passeio. %>
<% if passeio.cancelado? %>
  <span class="badge badge-secondary">Cancelado</span>
<% elsif passeio.lancado? %>
  <%= link_to "OS nº #{passeio.sorder_item.sorder_id}", sorder_path(passeio.sorder_item.sorder_id), class: "badge badge-success" %>
<% else %>
  <span class="badge badge-warning">Pendente</span>
<% end %>
