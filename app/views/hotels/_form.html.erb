<%= form_with(model: hotel, local: true) do |form| %>
  <% if hotel.errors.any? %>
    <div id="error_explanation">
      <h2><%= t("errors.template.header", model: hotel.model_name.human.downcase, count: hotel.errors.count) %></h2>

      <ul>
      <% hotel.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :sname %>
    <%= form.text_field :sname, class: "form-control" %>
  </div>

  <%= render "shared/campos_contato", form: form %>

  <div class="form-row">
    <div class="form-group col-md-3">
      <%= form.label :Valordiaria %>
      <%= form.number_field :Valordiaria, class: "form-control", step: "0.01", min: 0 %>
    </div>
  </div>
  <div class="form-group">
    <%= form.label :comments %>
    <%= form.text_area :comments, class: "form-control", rows: 3 %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
