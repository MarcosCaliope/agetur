<style type="text/css">
      @media print {
      .print {
        display: block;
      }
      .no-print {
        display: none;
      }
    }
  </style>

  <div class="no-print">
    Pesquisar por Nome
    <%= search_form_for @q do |f| %>
      <%= f.label :sname_cont, "Nome Contém" %>
      <%= f.search_field :sname_cont %>
      <%= f.submit %>
    <% end %>
  </div>

<h1>Hotéis</h1>
<%= ultimo_registro(Hotel) %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Nome</th>
      <th>Nome reduzido</th>
      <th>Telefone</th>
      <th>Contato</th>
      <th>Cidade</th>
      <th class="no-print">Valor da diária</th>
      <th colspan="3" class="no-print"></th>
    </tr>
  </thead>

  <tbody>
    <% @hotels.each do |hotel| %>
      <tr>
        <td><%= hotel.sname %></td>
        <td><%= hotel.short_name %></td>
        <td><%= hotel.phone %></td>
        <td><%= hotel.contact %></td>
        <td><%= [hotel.city, hotel.state&.uf].compact_blank.join(" / ") %></td>
        <td class="no-print"><%= hotel.Valordiaria %></td>
        <td class="no-print"><%= link_to 'Exibir', hotel %></td>
        <td class="no-print"><%= link_to 'Editar', edit_hotel_path(hotel) %></td>
        <td class="no-print"><%= link_to 'Excluir', hotel, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="no-print">
  <br>
  <%= link_to 'Novo Hotel', new_hotel_path %>
  <br>
  <%= link_to 'Lista em PDF', hotels_path(request.query_parameters.merge(format: 'pdf')) %>
</div>
<button onclick="print()" class="no-print">imprimir</button>
