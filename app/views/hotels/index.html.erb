<style type="text/css">
      @media print {
      .print {
        display: block;
      }
      .no-print {
        display: none;
      }
    }
  </style>

<h1>Hotéis</h1>
<%= ultimo_registro(Hotel) %>
<%= render "shared/pesquisa", url: hotels_path, dica: "Código, nome, nome reduzido, CPF/CNPJ, telefone, cidade…", total: @hotels.size %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nome</th>
      <th>Nome reduzido</th>
      <th>Telefone</th>
      <th>Contato</th>
      <th>Cidade</th>
      <th class="no-print">Valor da diária</th>
      <th colspan="3" class="no-print"></th>
    </tr>
  </thead>

  <tbody>
    <% @hotels.each do |hotel| %>
      <tr>
        <td><%= hotel.id %></td>
        <td><%= hotel.sname %></td>
        <td><%= hotel.short_name %></td>
        <td><%= hotel.phone %></td>
        <td><%= hotel.contact %></td>
        <td><%= [hotel.city, hotel.state&.uf].compact_blank.join(" / ") %></td>
        <td class="no-print"><%= hotel.Valordiaria %></td>
        <td class="no-print"><%= link_to 'Exibir', hotel %></td>
        <td class="no-print"><%= link_to 'Editar', edit_hotel_path(hotel) %></td>
        <td class="no-print"><%= link_to 'Excluir', hotel, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="no-print">
  <br>
  <%= link_to 'Novo Hotel', new_hotel_path %>
  <br>
  <%= link_to 'Lista em PDF', hotels_path(format: :pdf, busca: params[:busca].presence) %>
</div>
<button onclick="print()" class="no-print">imprimir</button>
