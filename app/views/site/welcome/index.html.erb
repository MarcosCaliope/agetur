<% if user_signed_in? || admin_signed_in? %>
  <header class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
      <%= company_logo_tag @empresa, :entrada, height: 64, class: "dashboard-logo mr-3" %>
      <h1 class="h3 mb-0">Agetur</h1>
    </div>
    <div class="text-muted small">
      <%= render 'layouts/empresa_atual' %> ·
      <% if admin_signed_in? %>
        Administrador <%= current_admin.email %> ·
        <%= link_to 'Administração', admins_backoffice_welcome_index_path %> ·
        <%= link_to 'Minha senha', minha_senha_path %> ·
        <%= link_to 'Sair', destroy_admin_session_path, method: :delete %>
      <% else %>
        <%= current_user.email %> ·
        <%= link_to 'Minha senha', minha_senha_path %> ·
        <%= link_to 'Sair', destroy_user_session_path, method: :delete %>
      <% end %>
    </div>
  </header>

  <% aba_ativa = ->(aba) { " show active" if aba == @abas.keys.first } %>
  <% if @abas.empty? %>
    <div class="alert alert-info">Seu perfil de acesso ainda não libera nenhuma tela. Fale com o administrador do sistema.</div>
  <% end %>
  <ul class="nav nav-tabs dashboard-tabs" role="tablist">
    <% @abas.each_with_index do |(aba, nome), indice| %>
      <li class="nav-item">
        <a class="nav-link<%= " active" if indice.zero? %>" id="<%= aba %>-tab" data-toggle="tab" href="#<%= aba %>" role="tab" aria-controls="<%= aba %>" aria-selected="<%= indice.zero? %>"><%= nome %></a>
      </li>
    <% end %>
  </ul>

  <div class="tab-content pt-4">
    <% if @abas.key?("cadastros") %>
    <section class="tab-pane fade<%= aba_ativa.call("cadastros") %>" id="cadastros" role="tabpanel" aria-labelledby="cadastros-tab">
      <div class="row">
        <% @cadastros.each do |cadastro| %>
          <div class="col-sm-6 col-lg-4 col-xl-3 mb-4">
            <div class="card h-100 dashboard-card">
              <div class="card-body">
                <h2 class="h5 card-title"><%= cadastro[:nome] %></h2>
                <p class="dashboard-total mb-0"><%= cadastro[:total] %></p>
                <p class="text-muted small mb-0"><%= cadastro[:total] == 1 ? "registro" : "registros" %></p>
              </div>
              <div class="card-footer bg-transparent border-top-0">
                <%= link_to 'Abrir', cadastro[:lista], class: "btn btn-primary btn-sm" %>
                <%= link_to 'Novo', cadastro[:novo], class: "btn btn-outline-secondary btn-sm" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
    <% end %>

    <% if @abas.key?("processos") %>
    <section class="tab-pane fade<%= aba_ativa.call("processos") %>" id="processos" role="tabpanel" aria-labelledby="processos-tab">
      <div class="row">
        <% if pode_acessar?("sorders") %>
        <div class="col-md-6 col-lg-5 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Ordem de Serviço</h2>
              <div class="d-flex text-center mt-3">
                <div class="flex-fill">
                  <p class="dashboard-total mb-0"><%= @ordens_hoje %></p>
                  <p class="text-muted small mb-0">hoje</p>
                </div>
                <div class="flex-fill">
                  <p class="dashboard-total mb-0"><%= @ordens_proximas %></p>
                  <p class="text-muted small mb-0">próximos 7 dias</p>
                </div>
                <div class="flex-fill">
                  <p class="dashboard-total mb-0"><%= @ordens_total %></p>
                  <p class="text-muted small mb-0">no total</p>
                </div>
              </div>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir', sorders_path, class: "btn btn-primary btn-sm" %>
              <%= link_to 'Nova ordem', new_sorder_path, class: "btn btn-outline-secondary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>

        <% if pode_acessar?("bookings") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Agendamentos</h2>
              <div class="d-flex text-center mt-3">
                <div class="flex-fill">
                  <p class="dashboard-total mb-0"><%= @agendamentos_pendentes %></p>
                  <p class="text-muted small mb-0">passeios sem OS</p>
                </div>
                <div class="flex-fill">
                  <p class="dashboard-total mb-0"><%= @agendamentos_semana %></p>
                  <p class="text-muted small mb-0">próximos 7 dias</p>
                </div>
              </div>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir', bookings_path, class: "btn btn-primary btn-sm" %>
              <%= link_to 'Novo', new_booking_path, class: "btn btn-outline-secondary btn-sm" %>
              <%= link_to 'Pendentes', pendentes_bookings_path, class: "btn btn-outline-secondary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>

        <% if pode_acessar?("cash_entries") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Caixa</h2>
              <p class="dashboard-total mb-0"><%= number_to_currency(@caixa_saldo) %></p>
              <p class="text-muted small mb-0">
                saldo · hoje: <%= number_to_currency(@caixa_hoje.entradas.sum(:valor)) %> de entradas,
                <%= number_to_currency(@caixa_hoje.saidas.sum(:valor)) %> de saídas
              </p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir', cash_entries_path, class: "btn btn-primary btn-sm" %>
              <%= link_to 'Novo lançamento', new_cash_entry_path, class: "btn btn-outline-secondary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>

        <% if pode_acessar?("payables") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Contas a pagar</h2>
              <p class="dashboard-total mb-0"><%= number_to_currency(@contas_abertas.sum(:valor)) %></p>
              <p class="text-muted small mb-0">
                em aberto (<%= @contas_abertas.count %>)
                <% if @contas_vencidas.exists? %>
                  · <span class="text-danger"><%= pluralize(@contas_vencidas.count, "vencida", plural: "vencidas") %>:
                  <%= number_to_currency(@contas_vencidas.sum(:valor)) %></span>
                <% end %>
              </p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir', payables_path, class: "btn btn-primary btn-sm" %>
              <%= link_to 'Nova conta', new_payable_path, class: "btn btn-outline-secondary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>

        <% if pode_acessar?("txt") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Importar clientes</h2>
              <p class="text-muted small mb-0">Cadastra clientes em lote a partir de um arquivo TXT separado por vírgulas.</p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir', txt_path, class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>
      </div>
    </section>
    <% end %>

    <% if @abas.key?("relatorios") %>
    <section class="tab-pane fade<%= aba_ativa.call("relatorios") %>" id="relatorios" role="tabpanel" aria-labelledby="relatorios-tab">
      <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Comissões</h2>
              <p class="dashboard-total mb-0"><%= number_to_currency(@comissoes_a_pagar) %></p>
              <p class="text-muted small mb-0">a pagar aos vendedores (passageiros não cancelados)</p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir relatório', showcomis_path, class: "btn btn-primary btn-sm" %>
              <%= link_to 'Pagar comissões', pagamento_comissoes_path, class: "btn btn-outline-secondary btn-sm" %>
            </div>
          </div>
        </div>
        <% if pode_acessar?("relacao_ordens") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Relação de ordens</h2>
              <p class="dashboard-total mb-0"><%= @ordens_mes %></p>
              <p class="text-muted small mb-0">
                ordens neste mês. Por período, roteiro, vendedor, guia, motorista, veículo ou hotel, com totais e PDF.
              </p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir relatório', relacao_ordens_path, class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>
        <% if pode_acessar?("resumo_operacional") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Resumo operacional</h2>
              <p class="text-muted small mb-0">
                Cada ordem do período com custos (guia, motorista, pedágio, combustível, despesas), valor, comissões e
                total, como o Resumo Operacional do SISTGER.
              </p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir relatório', resumo_operacional_path, class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>
        <% if pode_acessar?("agendamentos_por_usuario") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Agendamentos por usuário</h2>
              <p class="text-muted small mb-0">
                Passageiros lançados nas ordens do período, agrupados por quem os lançou, com o total de cada usuário.
              </p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir relatório', agendamentos_por_usuario_path, class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>
        <% if pode_acessar?("passeios_repassados") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Passeios repassados</h2>
              <p class="text-muted small mb-0">
                Passageiros repassados a outras agências no período, por agência, com o valor a receber e a comissão de
                repasse paga e a pagar.
              </p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir relatório', passeios_repassados_path, class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>
      </div>
    </section>
    <% end %>

    <% if @abas.key?("manutencao") %>
    <section class="tab-pane fade<%= aba_ativa.call("manutencao") %>" id="manutencao" role="tabpanel" aria-labelledby="manutencao-tab">
      <div class="row">
        <% if pode_acessar?("sistger_imports") %>
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100 dashboard-card">
            <div class="card-body">
              <h2 class="h5 card-title">Importar do SISTGER</h2>
              <p class="text-muted small mb-0">
                Traz empresa, clientes, agências, hotéis, vendedores, veículos, roteiros, ordens de serviço e
                passageiros do banco SQL Server do sistema antigo.
              </p>
            </div>
            <div class="card-footer bg-transparent border-top-0">
              <%= link_to 'Abrir', sistger_imports_path, class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        </div>
        <% end %>
      </div>
    </section>
    <% end %>
  </div>
<% else %>
  <div class="row justify-content-center mt-5">
    <div class="col-sm-10 col-md-6 col-lg-4">
      <div class="card text-center">
        <div class="card-body">
          <%= company_logo_tag @empresa, :entrada, height: 96, class: "dashboard-logo mb-3" %>
          <h1 class="h3 card-title">Agetur</h1>
          <p class="text-muted">Faça login para acessar o sistema.</p>
          <%= link_to 'Entrar', new_user_session_path, class: "btn btn-primary btn-block" %>
          <%= link_to 'Acesso administrativo', new_admin_session_path, class: "d-block mt-3 small" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
