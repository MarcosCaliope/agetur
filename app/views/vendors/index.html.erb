
<h1>Vendedores</h1>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>E-mail</th>
      <th>Endereço</th>
      <th>Telefone</th>
      <th>Observações</th>
      <th>Comissão</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @vendors.each do |vendor| %>
      <tr>
        <td><%= vendor.sname %></td>
        <td><%= vendor.email %></td>
        <td><%= vendor.address %></td>
        <td><%= vendor.phone %></td>
        <td><%= vendor.comments %></td>
        <td><%= vendor.commission %></td>
        <td><%= link_to 'Exibir', vendor %></td>
        <td><%= link_to 'Editar', edit_vendor_path(vendor) %></td>
        <td><%= link_to 'Excluir', vendor, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Vendedor', new_vendor_path %>
