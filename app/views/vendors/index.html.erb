
<h1>Vendedores</h1>
<%= ultimo_registro(Vendor) %>
<%= render "shared/pesquisa", url: vendors_path, dica: "Código, nome, nome reduzido, CPF/CNPJ, telefone, cidade…", total: @vendors.size %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nome</th>
      <th>Nome reduzido</th>
      <th>Telefone</th>
      <th>Contato</th>
      <th>Cidade</th>
      <th>Comissão (%)</th>
      <th>Situação</th>
      <th colspan="2"></th>
    </tr>
  </thead>

  <tbody>
    <% @vendors.each do |vendor| %>
      <tr class="<%= 'text-muted' unless vendor.active %>">
        <td><%= vendor.id %></td>
        <td><%= vendor.sname %></td>
        <td><%= vendor.short_name %></td>
        <td><%= vendor.phone %></td>
        <td><%= vendor.contact %></td>
        <td><%= [vendor.city, vendor.state&.uf].compact_blank.join(" / ") %></td>
        <td><%= vendor.no_commission ? "Não paga" : vendor.commission %></td>
        <td><%= vendor.active ? "Ativo" : "Inativo" %></td>
        <td class="text-nowrap">
          <%= link_icone 'eye', 'Exibir', vendor %>
          <%= link_icone 'pencil', 'Editar', edit_vendor_path(vendor), class: 'ml-2' %>
          <%= link_icone 'trash', 'Excluir', vendor, method: :delete, class: 'ml-2 text-danger', data: { confirm: 'Tem certeza?' } %>
        </td>
        <td><%= link_to 'Comissões', vendor_comissoes_path(vendor) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Vendedor', new_vendor_path %>
