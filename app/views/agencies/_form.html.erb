<%= form_with(model: agency, local: true) do |form| %>
  <% if agency.errors.any? %>
    <div id="error_explanation">
      <h2><%= t("errors.template.header", model: agency.model_name.human.downcase, count: agency.errors.count) %></h2>

      <ul>
      <% agency.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :sname %>
    <%= form.text_field :sname, class: "form-control" %>
  </div>

  <%= render "shared/campos_contato", form: form %>

  <div class="form-row">
    <div class="form-group col-md-3">
      <%= form.label :commission %>
      <%= form.number_field :commission, class: "form-control", step: "0.01", min: 0 %>
    </div>
    <div class="form-group col-md-6">
      <%= form.label :vendor_id %>
      <%= form.select :vendor_id, @vendor_options, { include_blank: "Nenhum" }, class: "form-control" %>
    </div>
  </div>
  <div class="form-group">
    <%= form.label :comments %>
    <%= form.text_area :comments, class: "form-control", rows: 3 %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
