
<h1>Agências</h1>
<%= ultimo_registro(Agency) %>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>Nome reduzido</th>
      <th>Telefone</th>
      <th>Contato</th>
      <th>Cidade</th>
      <th>Comissão (%)</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @agencies.each do |agency| %>
      <tr>
        <td><%= agency.sname %></td>
        <td><%= agency.short_name %></td>
        <td><%= agency.phone %></td>
        <td><%= agency.contact %></td>
        <td><%= [agency.city, agency.state&.uf].compact_blank.join(" / ") %></td>
        <td><%= agency.commission %></td>
        <td><%= link_to 'Exibir', agency %></td>
        <td><%= link_to 'Editar', edit_agency_path(agency) %></td>
        <td><%= link_to 'Excluir', agency, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Nova Agência', new_agency_path %>
