
<h1>Agências</h1>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>E-mail</th>
      <th>Endereço</th>
      <th>Telefone</th>
      <th>Observações</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @agencies.each do |agency| %>
      <tr>
        <td><%= agency.sname %></td>
        <td><%= agency.email %></td>
        <td><%= agency.address %></td>
        <td><%= agency.phone %></td>
        <td><%= agency.comments %></td>
        <td><%= link_to 'Exibir', agency %></td>
        <td><%= link_to 'Editar', edit_agency_path(agency) %></td>
        <td><%= link_to 'Excluir', agency, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Nova Agência', new_agency_path %>
