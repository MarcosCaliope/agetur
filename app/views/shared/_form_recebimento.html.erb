<%# New payment form (passenger or booked tour). locals: pagamento, url. %>
<%= form_with model: pagamento, url: url, local: true do |form| %>
  <%= render "shared/erros", registro: pagamento %>
  <div class="form-row">
    <div class="form-group col-sm-3 col-md-2">
      <%= form.label :data %>
      <%= form.date_field :data, class: "form-control" %>
    </div>
    <div class="form-group col-sm-3 col-md-2">
      <%= form.label :valor %>
      <%= form.number_field :valor, step: "0.01", min: "0.01", class: "form-control" %>
    </div>
    <div class="form-group col-sm-6 col-md-3">
      <%= form.label :forma_pagamento %>
      <%= form.select :forma_pagamento, CashEntry::FORMAS.invert, {}, class: "form-control" %>
    </div>
    <div class="form-group col-md-5">
      <%= form.label :descricao %>
      <%= form.text_field :descricao, class: "form-control" %>
    </div>
  </div>
  <div class="form-check mb-3">
    <%= form.check_box :lancar_no_caixa, class: "form-check-input" %>
    <%= form.label :lancar_no_caixa, "Lançar no caixa da data", class: "form-check-label" %>
  </div>
  <%= form.submit "Lançar recebimento", class: "btn btn-primary" %>
<% end %>
