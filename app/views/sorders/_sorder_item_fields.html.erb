<%# Paid amounts are moved by payments; only an admin corrects them here (SordersController::PAGOS). %>
<% pago = { size: 7, readonly: !admin_signed_in?, title: ("Lançado pelos recebimentos e pagamentos de comissão" unless admin_signed_in?) } %>
<table class="table table-hover">
    <div class="nested-fields">
        <%= f.label :ID %>
        <%= f.text_field :id  ,disabled: true , size:2%>
        
        <%= f.label :Hotel %>
        <%= f.select( "hotel_id", @hotel_options, { include_blank: "Selecione" }) %>
 
        <%= f.label :Apto %>
        <%= f.text_field :apto , size:7%>

        <%= f.label :Hora %>
        <%= f.text_field  :hour , size:8%>

        <%= f.label :PAX %>
        <%= f.number_field :qtdepax , size:5%>

        <%= f.label :CHD %>
        <%= f.number_field :qtdechd , size:5%>
        <%= f.label :Valor_Passeio %>
        <%= f.text_field :amount , size:7%>
        <%= f.label :Pago %>
        <%= f.text_field :amountpay, **pago %>
        <%= f.label :discount, "Desconto" %>
        <%= f.text_field :discount , size:6%>
        <%= f.label :vendor_discount, "Desc. vendedor" %>
        <%= f.text_field :vendor_discount , size:6%>

        <div>
        <%= f.label :Passageiro %>
        <%= f.text_field  :snomepax , size:45%>

        <%= f.label :Documento %>
        <%= f.select :documenttype, ["CPF", "RG", "PASSP"] %>

        <%= f.label :Número %>
        <%= f.text_field :document , size:10%>
        <%= f.label :Fone %>
        <%= f.telephone_field  :phone , size:10%>
        <p>
        <%= f.label :Vendedor %>
        <%= f.select( "vendor_id", @vendor_options, { include_blank: "Selecione" }) %>
        <%= f.label :Comissão %>
        <%= f.text_field :amountcomission , size:7%>
        <%= f.label :amountcomissionpay, "Pago" %>
        <%= f.text_field :amountcomissionpay, **pago %>
        <% if f.object.comissao_a_pagar? %>
          <%# Pays the commission left today, with a cash exit (CommissionPaymentsController#create). %>
          <% a_pagar = number_to_currency(f.object.comissao_a_pagar) %>
          <div class="dropdown d-inline-block">
            <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
              Pagar comissão
            </button>
            <div class="dropdown-menu">
              <% CashEntry::FORMAS.each do |forma, nome| %>
                <%= link_to nome, pagamento_comissoes_path(tipo: "comissao_vendedor", sorder_id: f.object.sorder_id, credor_id: f.object.vendor_id,
                                                           itens: [f.object.id], data: Time.zone.today, forma_pagamento: forma, retorno: "ordem"),
                      method: :post, class: "dropdown-item",
                      data: { confirm: "Pagar hoje #{a_pagar} de comissão a #{f.object.vendor.sname} (#{nome})? A saída é lançada no caixa." } %>
              <% end %>
            </div>
          </div>
        <% end %>
        </div>
        <%= f.label :Repassado %>
        <%= f.select( "agency_id", @agency_options, { include_blank: "        " }) %>
        <%= f.label :amountcomissionrep, "Comissão" %>
        <%= f.text_field :amountcomissionrep , size:7%>
        <%= f.label :amountcomissionreppay, "Pago" %>
        <%= f.text_field :amountcomissionreppay, **pago %>

        <%= f.label :Cancelado %>
        <%= f.select :scancelado, ["N", "S"] %>
        <%= f.label :forma_pagamento, "Forma de pagamento" %>
        <%= f.select :forma_pagamento, SorderItem::FORMAS_PAGAMENTO.invert, { include_blank: true } %>
        <p>
        <%= f.label :obs %>
        <%= f.text_field :comments , size:130%>

        <div class="ml-3 my-2 lista-pax">
          <strong>Lista pax</strong>
          <%= f.fields_for :companions do |companion| %>
            <%= render "companion_fields", f: companion %>
          <% end %>
          <%# Inserted right before this link, inside .lista-pax (lista_pax.js counts the rows there). %>
          <%= link_to_add_association "[Adicionar à lista pax]", f, :companions,
                data: { association_insertion_node: "this", association_insertion_method: "before" } %>
        </div>

        <%= link_to_remove_association('X', f, class: "btn btn-danger") %>
        
        <div>
        ________________________________________________________________________________________________________________________________________________________________________________!
        </div>
    
</table>