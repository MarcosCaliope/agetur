<p id="notice"><%= notice %> </p>

<%= search_form_for @q do |f| %>
  <%= f.label :data_cont %>
  <%= f.search_field :data_cont %>
  <%= f.submit %>
<% end %>

<h1>Ordens</h1>

<table class="table table-hover">
  <thead>
    <tr>
      <th>No.Ordem</th>
      <th>Data</th>
      <th>Observacoes</th>
      <th>Destino</th>
      <th>Guia</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @sorders.each do |sorder| %>
      <tr>
        <td><%= sorder.id %></td>
        <td><%= sorder.data %></td>
        <td><%= sorder.sobservacoes %></td>
        <td><%= sorder.destination.description%></td>
        <td><%= sorder.tourguide.sname%></td>
        
        <td><%= link_to 'Show', sorder %></td>
        <td><%= link_to 'Edit', edit_sorder_path(sorder) %></td>
        <td><%= link_to 'Destroy', sorder, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Sorder', new_sorder_path %> <br>
<td><%= link_to 'Arq.PDF', sorders_path(format: 'pdf') %></td>
