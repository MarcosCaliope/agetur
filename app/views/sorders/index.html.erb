
<style type="text/css">
      @media print {
      .print {
        display: block;
      }
      .no-print {
        display: none;
      }
  }
  </style>
  <div class="no-print">
    <%= search_form_for @q do |f| %>
      <%= f.label :data_gteq, "Data Inicial:" %>
      <%= f.date_field :data_gteq %>
      <%= f.label :data_lteq, "Data Final:" %>
      <%= f.date_field :data_lteq %>

      <%= f.label :destination_id_eq, "Roteiro" %>
      <%= f.collection_select :destination_id_eq, Destination.all, :id, :description, include_blank: true %>

      <%= f.submit %>
    <% end %>
  </div>
<h3>Ordens de Serviço</h3>

<table class="table table-hover">
  <thead>
    <tr>
      <th>No.Ordem</th>
      <th>Data</th>
      <th>Destino</th>
      <th>Observações</th>
      <th>Guia</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @sorders.each do |sorder| %>
      <tr>
        <td><%= sorder.id %></td>
        <td><%= sorder.data&.strftime("%d/%m/%Y") %></td>
        <td><%= sorder.destination.description%></td>
        <td><%= sorder.sobservacoes %></td>
        <td><%= sorder.tourguide.sname%></td>

        <td class="no-print"><%= link_to 'Exibir', sorder %></td>
        <td class="no-print"><%= link_to 'Editar', edit_sorder_path(sorder) %></td>
        <td class="no-print"><%= link_to 'Excluir', sorder, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<div class="no-print">
  <%= link_to 'Nova Ordem', new_sorder_path %> <br>
  <%= link_to 'Arq.PDF', sorders_path(request.query_parameters.merge(format: 'pdf')) %> <br>
</div>
<button onclick="print()" class="no-print">imprimir</button>
