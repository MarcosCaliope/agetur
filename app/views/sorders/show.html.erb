
<%= form_with(model: @sorder, local: true) do |form| %>

  <style type="text/css">
      @media print {
      .print {
        display: block;
      }
      .no-print {
        display: none;
      }
  }
  </style>

  <div class="container">
  <td><%= company_logo_tag @sorder.company, :formulario %>
  <%= @sorder.company.name %>
    <p> 
    Endereço:
    <%= @sorder.company.address %>
      Fone: 
    <%= @sorder.company.phone %>
      Cidade: 
    <%= @sorder.company.city %>
      CNPJ: 
    <%= @sorder.company.cnpj %>
    <p> 
    Email: 
    <%= @sorder.company.email %>
      Site: 
    <%= @sorder.company.site %>
    </td>
  </div>
  <p>
    <div class="container">  
      <strong>No.Ordem:</strong>
        <%= @sorder.id %>
        <% if @sorder.encerrada? %><span class="badge badge-secondary">Encerrada</span><% end %>
        <strong>Data:</strong>
        <%= @sorder.data %>
        <strong>Destino:</strong>
        <%= @sorder.destination.description %>
        <strong>Guia:</strong>
        <%= @sorder.tourguide.sname %>
        <p>
          <strong>observacoes:</strong>
          <%= @sorder.sobservacoes %>
        </p>
        <p>
          <strong>Total de PAX:</strong> <%= @sorder.total_pax %>
          <strong>Total de CHD:</strong> <%= @sorder.total_chd %>
        </p>
    </div>

  <table class="table table-hover">
    <thead>
      <tr>
        <th>Hotel</th>
        <th>Apto</th>
        <th>Passageiro</th>
        <th>Tipo Doc</th>
        <th>Documento</th>
        <th>Telefone</th>
        <th>PAX</th>
        <th>CHD</th>
        <th>A Receber</th>
        <th>Solicitante</th>
        <th>Observações</th>
        <th class="no-print"></th>
      </tr>
    </thead>
    <tbody>
      <% @sorder_item.ativos.each do |sorder_item| %>
        <tr>
          <td><%= sorder_item.hotel&.sname %></td>
          <td><%= sorder_item.apto %></td>
          <td>
            <%= sorder_item.nome_passageiro %>
            <% if sorder_item.companions.any? %>
              <div class="small text-muted">Lista pax: <%= sorder_item.companions.map(&:descricao).join("; ") %></div>
            <% end %>
          </td>
          <td><%= sorder_item.documenttype %></td>
          <td><%= sorder_item.document %></td>
          <td><%= sorder_item.phone %></td>
          <td><%= sorder_item.qtdepax %></td>
          <td><%= sorder_item.qtdechd %></td>
          <td><%= sorder_item.total_passeio %></td>
          <td><%= sorder_item.vendor&.sname %></td>
          <td><%= sorder_item.comments %></td>
          <td class="no-print"><%= link_to "Recebimentos", sorder_item_recebimentos_path(sorder_item) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="no-print">
    <%= link_to '[Voltar]', sorders_path %>
    <% if @sorder.encerrada? %>
      <%= link_to '[Reabrir OS]', reabrir_sorder_path(@sorder), method: :patch,
            data: { confirm: "Reabrir a OS? As contas a pagar geradas pelo encerramento e ainda não pagas serão removidas." } %>
    <% else %>
      <%= link_to '[Editar]', edit_sorder_path(@sorder) %>
      <%= link_to '[Encerrar OS]', encerrar_sorder_path(@sorder), method: :patch,
            data: { confirm: "Encerrar a OS? Ela deixa de aceitar alterações e recebimentos, e as comissões e custos em aberto viram contas a pagar." } %>
    <% end %>
    <%= link_to 'Baixar PDF', export_sorder_path(@sorder), target: "_blank" %>
    <button type="button" onclick="print()">imprimir</button>
  </div>
<% end %>
