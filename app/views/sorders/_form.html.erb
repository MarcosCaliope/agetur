<%= form_with(model: sorder, local: true, data: { avisar_alteracoes: true }) do |form| %>
  <%= form.hidden_field :lock_version if sorder.persisted? %>
  <% if sorder.errors.any? %>
    <div id="error_explanation">
      <h2><%= t("errors.template.header", model: sorder.model_name.human.downcase, count: sorder.errors.count) %></h2>

      <ul>
      <% sorder.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <%# Also at the top: orders with many passengers make a long form. %>
  <div class="actions mb-2">
    <%= form.submit class: "btn btn-primary" %>
  </div>

  <%# Header: number and company, then the trip, then the costs (no longer in a modal). %>
  <div class="card mb-3 ordem-cabecalho">
    <div class="card-body">
      <div class="d-flex flex-wrap align-items-center mb-3">
        <div class="mr-3"><%= company_logo_tag sorder.company || empresa_atual, :formulario, height: 56 %></div>
        <div>
          <h2 class="h3 mb-0 ordem-numero">
            <% if sorder.persisted? %>
              Ordem de serviço nº <%= sorder.numero %>
            <% else %>
              Nova ordem de serviço
            <% end %>
          </h2>
          <%# The order belongs to the company being worked in (DaEmpresa). %>
          <div class="text-muted"><%= (sorder.company || empresa_atual)&.name %></div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-md-2">
          <%= form.label :data %>
          <%= form.date_field :data, class: "form-control" %>
        </div>
        <div class="form-group col-md-4">
          <%= form.label :destination_id, "Destino" %>
          <div class="input-group">
            <%= form.select :destination_id, @destination_options, { include_blank: "Selecione" }, class: "custom-select" %>
            <div class="input-group-append"><%= botao_cadastro_rapido("destinations", "novo-roteiro", "roteiro", grupo: true) %></div>
          </div>
        </div>
        <div class="form-group col-md-6">
          <%= form.label :sobservacoes, "Observações" %>
          <%= form.text_field :sobservacoes, class: "form-control" %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group col-md-4">
          <%= form.label :tourguide_id, "Guia" %>
          <div class="input-group">
            <%= form.select :tourguide_id, @tourguide_options, { include_blank: "Selecione" }, class: "custom-select" %>
            <div class="input-group-append"><%= botao_cadastro_rapido("tourguides", "novo-guia", "guia", grupo: true) %></div>
          </div>
        </div>
        <div class="form-group col-md-4">
          <%= form.label :driver_id, "Motorista" %>
          <div class="input-group">
            <%= form.select :driver_id, @driver_options, { include_blank: "Selecione" }, class: "custom-select" %>
            <div class="input-group-append"><%= botao_cadastro_rapido("drivers", "novo-motorista", "motorista", grupo: true) %></div>
          </div>
        </div>
        <div class="form-group col-md-4">
          <%= form.label :vehicle_id, "Veículo" %>
          <div class="input-group">
            <%= form.select :vehicle_id, @vehicle_options, { include_blank: "Selecione" }, class: "custom-select" %>
            <div class="input-group-append"><%= botao_cadastro_rapido("vehicles", "novo-veiculo", "veículo", grupo: true) %></div>
          </div>
        </div>
      </div>

      <h3 class="h6 text-muted border-top pt-3">Despesas e valores</h3>
      <div class="form-row">
        <% [[:valorguia, "Guia"], [:valormotorista, "Motorista"], [:valorpedagio, "Pedágio"], [:valorcombustivel, "Combustível"],
            [:valordespesas, "Outras despesas"], [:valoros, "Valor da OS"], [:valorfinalos, "Valor final"]].each do |campo, rotulo| %>
          <div class="form-group col-6 col-md">
            <%= form.label campo, rotulo %>
            <%= form.text_field campo, class: "form-control text-right", inputmode: "decimal" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

    <div id='sorder_items'>
    <%= link_to_add_association '[Adicionar PAX]', form, :sorder_items, class: "btn btn-outline-primary btn-sm mb-3" %>
      <%# Cancelled passengers are listed (and brought back) on the order's page. %>
      <%= form.fields_for :sorder_items, sorder.sorder_items.reject { |item| item.scancelado_in_database == "S" } do |sorder_item| %>
      <%= render partial: "sorder_item_fields", locals: { f: sorder_item } %>
      <% end %>
    </div>

    <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
    <% if sorder.persisted? %>
      <%= link_to 'Exportar PDF', export_sorder_path(sorder), target: "_blank" %>
    <% end %>
  </div>
<% end %>

<%= render "cadastro_rapido" %>
