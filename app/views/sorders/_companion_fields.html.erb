<div class="nested-fields form-inline mb-1">
  <%= f.text_field :snome, size: 35, placeholder: "Nome", class: "form-control form-control-sm mr-1 mb-1", aria: { label: "Nome na lista pax" } %>
  <%= f.select :documenttype, (["CPF", "RG", "PASSP"] | [f.object.documenttype]).compact, { include_blank: "Doc." },
        class: "custom-select custom-select-sm mr-1 mb-1", aria: { label: "Tipo de documento" } %>
  <%= f.text_field :document, size: 14, placeholder: "Número", class: "form-control form-control-sm mr-2 mb-1", aria: { label: "Número do documento" } %>
  <div class="form-check mr-2 mb-1"><%= f.check_box :chd, class: "form-check-input" %><%= f.label :chd, "CHD", class: "form-check-label small" %></div>
  <div class="form-check mr-2 mb-1"><%= f.check_box :colo, class: "form-check-input" %><%= f.label :colo, "Colo", class: "form-check-label small" %></div>
  <%= link_to_remove_association "X", f, class: "btn btn-outline-danger btn-sm mb-1", title: "Tirar da lista pax" %>
</div>
