<%# Quick-add modals for the order form's guide, driver and vehicle selects
    and each passenger's vendor (cadastro_rapido.js). Rendered after the
    order form, since forms can't nest. Each posts JSON to the cadastro's own
    create action, so the same permission applies; the "+" right after a
    select opens its modal. `selects` are the selects that get the new
    record; the one next to the clicked "+" picks it. %>
<% cadastros = [
     { id: "novo-guia", titulo: "Novo guia", modelo: Tourguide, url: tourguides_path(format: :json), selects: "#sorder_tourguide_id",
       rotulo: "sname", campos: [[:sname, "Nome", true], [:short_name, "Nome reduzido"], [:phone, "Telefone"]] },
     { id: "novo-motorista", titulo: "Novo motorista", modelo: Driver, url: drivers_path(format: :json), selects: "#sorder_driver_id",
       rotulo: "sname", campos: [[:sname, "Nome", true], [:short_name, "Nome reduzido"], [:phone, "Telefone"]] },
     { id: "novo-veiculo", titulo: "Novo veículo", modelo: Vehicle, url: vehicles_path(format: :json), selects: "#sorder_vehicle_id",
       rotulo: "license", campos: [[:license, "Placa", true], [:vehicle_type, "Tipo"], [:smodel, "Modelo"], [:capacity, "Capacidade"]],
       estado: true },
     { id: "novo-vendedor", titulo: "Novo vendedor", modelo: Vendor, url: vendors_path(format: :json),
       selects: "select[name$='[vendor_id]']", rotulo: "sname",
       campos: [[:sname, "Nome", true], [:short_name, "Nome reduzido"], [:phone, "Telefone"], [:commission, "Comissão (%)"]] }
   ] %>
<% cadastros.each do |cadastro| %>
  <% next unless pode_acessar?(cadastro[:modelo].model_name.route_key, "create") %>
  <% escopo = cadastro[:modelo].model_name.param_key %>
  <div class="modal fade cadastro-rapido-modal" id="<%= cadastro[:id] %>" tabindex="-1" role="dialog" aria-labelledby="<%= cadastro[:id] %>-titulo" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <%= form_with url: cadastro[:url], scope: escopo, local: true, class: "modal-content cadastro-rapido",
                    data: { selects: cadastro[:selects], rotulo: cadastro[:rotulo] } do |f| %>
        <div class="modal-header">
          <h5 class="modal-title" id="<%= cadastro[:id] %>-titulo"><%= cadastro[:titulo] %></h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger cadastro-rapido-erros" hidden></div>
          <% cadastro[:campos].each do |campo, rotulo, obrigatorio| %>
            <div class="form-group">
              <%= f.label campo, rotulo, for: "#{cadastro[:id]}-#{campo}" %>
              <%= f.text_field campo, id: "#{cadastro[:id]}-#{campo}", class: "form-control", required: obrigatorio %>
            </div>
          <% end %>
          <% if cadastro[:estado] %>
            <div class="form-group">
              <%= f.label :state_id, "Estado", for: "#{cadastro[:id]}-state_id" %>
              <%= f.select :state_id, State.order(:uf).pluck(:uf, :id), { selected: empresa_atual&.state_id },
                           id: "#{cadastro[:id]}-state_id", class: "form-control", required: true %>
            </div>
          <% end %>
          <p class="small text-muted mb-0">Os demais dados podem ser completados depois, no cadastro.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
          <%= f.submit "Cadastrar e selecionar", class: "btn btn-primary", data: { disable_with: false } %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
