<%= form_with(model: customer, local: true) do |form| %>
  <% if customer.errors.any? %>
    <div id="error_explanation">
      <h2><%= t("errors.template.header", model: customer.model_name.human.downcase, count: customer.errors.count) %></h2>

      <ul>
      <% customer.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-row">
    <div class="form-group col-md-6">
      <%= form.label :nome %>
      <%= form.text_field :nome, class: "form-control" %>
    </div>
    <div class="form-group col-md-3">
      <%= form.label :document %>
      <%= form.text_field :document, class: "form-control" %>
    </div>
    <div class="form-group col-md-3">
      <%= form.label :state_registration %>
      <%= form.text_field :state_registration, class: "form-control" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-md-6">
      <%= form.label :email %>
      <%= form.email_field :email, class: "form-control" %>
    </div>
    <div class="form-group col-md-6">
      <%= form.label :website %>
      <%= form.text_field :website, class: "form-control" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-md-6">
      <%= form.label :address %>
      <%= form.text_field :address, class: "form-control" %>
    </div>
    <div class="form-group col-md-6">
      <%= form.label :neighborhood %>
      <%= form.text_field :neighborhood, class: "form-control" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-md-6">
      <%= form.label :city %>
      <%= form.text_field :city, class: "form-control" %>
    </div>
    <div class="form-group col-md-2">
      <%= form.label :state_id %>
      <%= form.select :state_id, @state_options, { include_blank: "Selecione" }, class: "form-control" %>
    </div>
    <div class="form-group col-md-4">
      <%= form.label :zipcode %>
      <%= form.text_field :zipcode, class: "form-control" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-md-3">
      <%= form.label :phone %>
      <%= form.telephone_field :phone, class: "form-control" %>
    </div>
    <div class="form-group col-md-3">
      <%= form.label :phone2 %>
      <%= form.telephone_field :phone2, class: "form-control" %>
    </div>
    <div class="form-group col-md-3">
      <%= form.label :fax %>
      <%= form.telephone_field :fax, class: "form-control" %>
    </div>
    <div class="form-group col-md-3">
      <%= form.label :contact %>
      <%= form.text_field :contact, class: "form-control" %>
    </div>
  </div>

  <h5 class="mt-2">Cobrança</h5>
  <div class="form-row">
    <div class="form-group col-md-6">
      <%= form.label :billing_address %>
      <%= form.text_field :billing_address, class: "form-control" %>
    </div>
    <div class="form-group col-md-6">
      <%= form.label :billing_neighborhood %>
      <%= form.text_field :billing_neighborhood, class: "form-control" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-md-6">
      <%= form.label :billing_city %>
      <%= form.text_field :billing_city, class: "form-control" %>
    </div>
    <div class="form-group col-md-2">
      <%= form.label :billing_state_id %>
      <%= form.select :billing_state_id, @state_options, { include_blank: "Selecione" }, class: "form-control" %>
    </div>
    <div class="form-group col-md-4">
      <%= form.label :billing_zipcode %>
      <%= form.text_field :billing_zipcode, class: "form-control" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group col-md-4">
      <%= form.label :billing_phone %>
      <%= form.telephone_field :billing_phone, class: "form-control" %>
    </div>
    <div class="form-group col-md-4">
      <%= form.label :billing_phone2 %>
      <%= form.telephone_field :billing_phone2, class: "form-control" %>
    </div>
    <div class="form-group col-md-4">
      <%= form.label :billing_fax %>
      <%= form.telephone_field :billing_fax, class: "form-control" %>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :comments %>
    <%= form.text_area :comments, class: "form-control", rows: 3 %>
  </div>

  <div class="actions">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
