
<h1>Clientes</h1>
<%= ultimo_registro(Customer) %>
<%= render "shared/pesquisa", url: customers_path, dica: "Código, nome, CPF/CNPJ, telefone, contato, cidade…", total: @customers.size %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nome</th>
      <th>E-mail</th>
      <th>Telefone</th>
      <th>Documento</th>
      <th>Observações</th>
      <th>Cidade</th>
      <th>UF</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><%= customer.id %></td>
        <td><%= customer.nome %></td>
        <td><%= customer.email %></td>
        <td><%= customer.phone %></td>
        <td><%= customer.document %></td>
        <td><%= customer.comments %></td>
        <td><%= customer.city %></td>
        <td class="text-nowrap">
          <%= link_icone 'eye', 'Exibir', customer %>
          <%= link_icone 'pencil', 'Editar', edit_customer_path(customer), class: 'ml-2' %>
          <%= link_icone 'trash', 'Excluir', customer, method: :delete, class: 'ml-2 text-danger', data: { confirm: 'Tem certeza?' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Cliente', new_customer_path %>
