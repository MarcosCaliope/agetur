
<h1>Clientes</h1>
<%= ultimo_registro(Customer) %>
<%= render "shared/pesquisa", url: customers_path, dica: "Código, nome, CPF/CNPJ, telefone, contato, cidade…", total: @customers.size %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nome</th>
      <th>E-mail</th>
      <th>Telefone</th>
      <th>Documento</th>
      <th>Observações</th>
      <th>Cidade</th>
      <th>UF</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @customers.each do |customer| %>
      <tr>
        <td><%= customer.id %></td>
        <td><%= customer.nome %></td>
        <td><%= customer.email %></td>
        <td><%= customer.phone %></td>
        <td><%= customer.document %></td>
        <td><%= customer.comments %></td>
        <td><%= customer.city %></td>
        <td><%= link_to 'Exibir', customer %></td>
        <td><%= link_to 'Editar', edit_customer_path(customer) %></td>
        <td><%= link_to 'Excluir', customer, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Cliente', new_customer_path %>
