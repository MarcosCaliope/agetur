
<h1>Passageiros</h1>

<table>
  <thead>
    <tr>
      <th>Ordem de serviço</th>
      <th>Observações</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @sorder_items.each do |sorder_item| %>
      <tr>
        <td><%= sorder_item.sorder %></td>
        <td><%= sorder_item.comments %></td>
        <td><%= link_to 'Exibir', sorder_item %></td>
        <td><%= link_to 'Editar', edit_sorder_item_path(sorder_item) %></td>
        <td><%= link_to 'Excluir', sorder_item, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Passageiro', new_sorder_item_path %>
