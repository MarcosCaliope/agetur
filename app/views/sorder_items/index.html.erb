
<h1>Passageiros</h1>

<table>
  <thead>
    <tr>
      <th>Ordem de serviço</th>
      <th>Observações</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @sorder_items.each do |sorder_item| %>
      <tr>
        <td><%= sorder_item.sorder %></td>
        <td><%= sorder_item.comments %></td>
        <td class="text-nowrap">
          <%= link_icone 'eye', 'Exibir', sorder_item %>
          <%= link_icone 'pencil', 'Editar', edit_sorder_item_path(sorder_item), class: 'ml-2' %>
          <%= link_icone 'trash', 'Excluir', sorder_item, method: :delete, class: 'ml-2 text-danger', data: { confirm: 'Tem certeza?' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Passageiro', new_sorder_item_path %>
