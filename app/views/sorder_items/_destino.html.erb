<%# The order typed in Transferir / copiar (movimentar): what it is, and why it can't take the passenger. %>
<% if @destino %>
  <% avisos = [] %>
  <% avisos << "É a OS atual do passageiro." if @destino.id == @sorder_item.sorder_id %>
  <% avisos << "OS encerrada: reabra-a para receber passageiros." if @destino.encerrada? %>
  <% if avisos.empty? && @destino.destination_id != @sorder_item.sorder.destination_id %>
    <% avisos << "Roteiro diferente do atual: o horário do passageiro será recalculado." %>
  <% end %>
  <div class="alert alert-<%= avisos.empty? ? "info" : "warning" %> mb-0" data-descricao="<%= descricao_destino(@destino) %>">
    <strong><%= descricao_destino(@destino) %></strong><br>
    Guia: <%= @destino.tourguide&.sname %> · Motorista: <%= @destino.driver&.sname %> ·
    <%= @destino.total_pax %> PAX, <%= @destino.total_chd %> CHD
    <% avisos.each do |aviso| %><div class="font-weight-bold"><%= aviso %></div><% end %>
  </div>
<% elsif params[:destino_id].present? %>
  <div class="alert alert-warning mb-0">OS nº <%= params[:destino_id] %> não encontrada nesta empresa.</div>
<% end %>
