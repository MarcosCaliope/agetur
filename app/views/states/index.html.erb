
<h1>Estados</h1>

<table>
  <thead>
    <tr>
      <th>UF</th>
      <th>Nome</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @states.each do |state| %>
      <tr>
        <td><%= state.uf %></td>
        <td><%= state.name %></td>
        <td class="text-nowrap">
          <%= link_icone 'eye', 'Exibir', state %>
          <%= link_icone 'pencil', 'Editar', edit_state_path(state), class: 'ml-2' %>
          <%= link_icone 'trash', 'Excluir', state, method: :delete, class: 'ml-2 text-danger', data: { confirm: 'Tem certeza?' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Estado', new_state_path %>
