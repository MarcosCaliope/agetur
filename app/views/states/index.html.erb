
<h1>Estados</h1>

<table>
  <thead>
    <tr>
      <th>UF</th>
      <th>Nome</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @states.each do |state| %>
      <tr>
        <td><%= state.uf %></td>
        <td><%= state.name %></td>
        <td><%= link_icone 'eye', 'Exibir', state %></td>
        <td><%= link_icone 'pencil', 'Editar', edit_state_path(state) %></td>
        <td><%= link_icone 'trash', 'Excluir', state, method: :delete, class: 'text-danger', data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Estado', new_state_path %>
