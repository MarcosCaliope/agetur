
<h1>Estados</h1>

<table>
  <thead>
    <tr>
      <th>UF</th>
      <th>Nome</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @states.each do |state| %>
      <tr>
        <td><%= state.uf %></td>
        <td><%= state.name %></td>
        <td><%= icone_link :exibir, state %></td>
        <td><%= icone_link :editar, edit_state_path(state) %></td>
        <td><%= icone_link :excluir, state, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Estado', new_state_path %>
