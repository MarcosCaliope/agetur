<h1 class="h3">Acesso das empresas</h1>
<p><%= link_to "Mensalidades do mês", admins_backoffice_mensalidades_path, class: "btn btn-primary btn-sm" %></p>
<p class="text-muted">
  Os usuários ligados a uma empresa bloqueada, ou com o acesso vencido, não conseguem entrar no sistema, e quem estiver
  logado é desconectado na próxima página. Usuários com "Todas as empresas" e os administradores não são afetados.
</p>

<table class="table table-sm table-hover">
  <thead><tr><th>Código</th><th>Empresa</th><th>Usuários</th><th class="text-right">Mensalidade</th><th>Último mês pago</th><th>Situação</th><th></th></tr></thead>
  <tbody>
    <% @companies.each do |company| %>
      <tr>
        <td><%= company.id %></td>
        <td><%= company.name %></td>
        <td><%= @usuarios.fetch(company.id, 0) %></td>
        <td class="text-right"><%= company.cobrada? ? number_to_currency(company.mensalidade_valor) : "—" %></td>
        <td><%= l(@ultimas_pagas[company.id], format: "%B/%Y").capitalize if @ultimas_pagas[company.id] %></td>
        <td><%= render "situacao", company: company %></td>
        <td class="text-nowrap">
          <%= link_icone "pencil", "Editar acesso", edit_admins_backoffice_company_path(company) %>
          <%= link_icone "money", "Pagamentos da empresa", admins_backoffice_company_mensalidades_path(company), class: "ml-2" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
