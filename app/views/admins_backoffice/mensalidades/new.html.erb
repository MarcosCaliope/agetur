<h1 class="h3">Registrar pagamento</h1>
<p class="lead"><%= @company.name %></p>

<%= form_with(model: @mensalidade, url: admins_backoffice_company_mensalidades_path(@company), local: true) do |form| %>
  <%= hidden_field_tag :retorno, params[:retorno] if params[:retorno].present? %>
  <%= render "shared/erros", registro: @mensalidade %>
  <div class="form-row">
    <div class="form-group col-md-3">
      <%= form.label :referencia %>
      <%= form.month_field :referencia, class: "form-control", required: true %>
    </div>
    <div class="form-group col-md-3">
      <%= form.label :valor %>
      <%= form.number_field :valor, step: "0.01", min: "0.01", class: "form-control", required: true %>
    </div>
    <div class="form-group col-md-3">
      <%= form.label :pago_em %>
      <%= form.date_field :pago_em, class: "form-control", required: true %>
    </div>
    <div class="form-group col-md-3">
      <%= form.label :forma %>
      <%= form.select :forma, Mensalidade::FORMAS, { include_blank: true }, class: "form-control" %>
    </div>
  </div>
  <div class="form-group">
    <%= form.label :observacao %>
    <%= form.text_field :observacao, class: "form-control" %>
  </div>
  <% if @company.dia_vencimento && @mensalidade.referencia %>
    <p class="text-muted small">
      Pagando <%= l(@mensalidade.referencia, format: "%B/%Y") %>, o acesso fica liberado até <%= l @mensalidade.liberado_ate %>
      (vencimento do mês seguinte mais <%= pluralize(@company.dias_tolerancia, "dia", plural: "dias") %> de tolerância).
    </p>
  <% end %>
  <%= form.submit "Registrar", class: "btn btn-primary" %>
  <%= link_to "Voltar", params[:retorno] == "mes" ? admins_backoffice_mensalidades_path : admins_backoffice_company_mensalidades_path(@company), class: "btn btn-link" %>
<% end %>
