<h1>Pagar conta</h1>
<p>
  <strong><%= @payable.descricao %></strong> — <%= @payable.nome_credor %><br>
  Vencimento <%= l(@payable.vencimento) %> · <%= number_to_currency(@payable.valor) %>
</p>

<% if @erros.present? %>
  <div class="alert alert-danger"><ul class="mb-0"><% @erros.each do |erro| %><li><%= erro %></li><% end %></ul></div>
<% end %>

<%= form_with scope: :pagamento, url: pagar_payable_path(@payable), method: :patch, local: true do |form| %>
  <div class="form-row">
    <div class="form-group col-sm-4 col-md-2">
      <%= form.label :data, "Data do pagamento" %>
      <%= form.date_field :data, value: params.dig(:pagamento, :data) || Time.zone.today, class: "form-control" %>
    </div>
    <div class="form-group col-sm-4 col-md-3">
      <%= form.label :forma_pagamento, "Forma de pagamento" %>
      <%= form.select :forma_pagamento, CashEntry::FORMAS.invert, { selected: params.dig(:pagamento, :forma_pagamento) || "D" },
            class: "form-control" %>
    </div>
    <div class="form-group col-sm-4 col-md-2">
      <%= form.label :valor, "Valor pago" %>
      <%= form.number_field :valor, value: params.dig(:pagamento, :valor) || @payable.valor, step: "0.01", min: "0.01",
            class: "form-control" %>
    </div>
  </div>
  <p class="text-muted small">O pagamento é lançado como saída no caixa da data.</p>
  <%= form.submit "Pagar", class: "btn btn-primary" %>
<% end %>
<p class="mt-3"><%= link_to "[Voltar]", payables_path %></p>
