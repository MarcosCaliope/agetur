<%= form_with(model: payable, local: true) do |form| %>
  <%= render "shared/erros", registro: payable %>
  <% unless payable.tipo == "avulsa" %>
    <p class="text-muted"><%= payable.nome_tipo %><%= " da OS nº #{payable.sorder_id}" if payable.sorder_id %></p>
  <% end %>
  <div class="form-group">
    <%= form.label :descricao %>
    <%= form.text_field :descricao, class: "form-control" %>
  </div>
  <div class="form-row">
    <div class="form-group col-md-6">
      <%= form.label :credor_nome %>
      <%= form.text_field :credor_nome, class: "form-control", placeholder: payable.credor.try(:sname) %>
    </div>
    <div class="form-group col-sm-6 col-md-3">
      <%= form.label :valor %>
      <%= form.number_field :valor, step: "0.01", min: "0.01", class: "form-control" %>
    </div>
    <div class="form-group col-sm-6 col-md-3">
      <%= form.label :vencimento %>
      <%= form.date_field :vencimento, class: "form-control" %>
    </div>
  </div>
  <div class="form-group">
    <%= form.label :observacoes %>
    <%= form.text_field :observacoes, class: "form-control" %>
  </div>
  <%= form.submit class: "btn btn-primary" %>
<% end %>
