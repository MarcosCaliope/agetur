<p id="notice"><%= notice %></p>

<h1>Service Order Items</h1>

<table class="table table-hover">
  <thead>
    <tr>
    <th>OS</th>
    <th>Seq.</th>
      <th>Destino</th>
      <th>Passageiro</th>
      <th>Tip Doc.</th>
      <th>Documento</th>
      <th>Hotel</th>
      <th>Apto</th>
      <th>Qtdepax</th>
      <th>Hour</th>
      <th>Fone</th>
      <th>Vendedor</th>
      <th>Valor</th>
      <th>Pago</th>
      <th>Comissão</th>
      <th>Obs.</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @service_order_items.each do |service_order_item| %>
      <tr>
      <td><%= service_order_item.service_order_id %></td>
      <td><%= service_order_item.id %></td>
      <td><%= service_order_item.service_order.destination.description %></td>
        <td><%= service_order_item.nomepax %></td>
        <td><%= service_order_item.documenttype %></td>
        <td><%= service_order_item.document %></td>
        <td><%= service_order_item.hotel.sname %></td>
        <td><%= service_order_item.apto %></td>
        <td><%= service_order_item.qtdepax %></td>
        <td><%= service_order_item.hour %></td>
        <td><%= service_order_item.phone %></td>
        <td><%= service_order_item.vendor.sname %></td>
        <td><%= service_order_item.amount %></td>
        <td><%= service_order_item.amountpay %></td>
        <td><%= service_order_item.amountcomission %></td>
        <td><%= service_order_item.comments %></td>
        <td><%= link_to 'Show', service_order_item %></td>
        <td><%= link_to 'Edit', edit_service_order_item_path(service_order_item) %></td>
        <td><%= link_to 'Destroy', service_order_item, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Service Order Item', new_service_order_item_path %>
