<table class="table table-hover">
  <h5> Itens da Ordem</h5>
  <thead>
    <tr>
    <th>Ordem</th>
    <th>Seq.</th>
    <th>Passageiro</th>
    <th>Hotel</th>
    <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <! -comentarios: Fazer loop dos itens da ordem ->
    
    <% @service_order_item.each do |service_order_item| %>  
      <td><%= service_order_item.service_order_id %></td>
      <td><%= service_order_item.id %></td>
      <td><%= service_order_item.nomepax %></td>
      <td><%= service_order_item.hotel.sname %></td>
      <td><%= link_to 'Editar item', edit_service_order_item_path(service_order_item.id) %></td>
      <%= link_to ‘DOWNLOAD PDF’, service_orders_path(@service_order, format => :pdf) %>
      <!-- 
      <td><%= link_to 'Create PDF document', service_orders_path(@service_order, :format => :pdf) %></td> 
      -->

      </tr>
  <% end %>

  </tbody>
</table>

