<p id="notice"><%= notice %></p>

<h1>Ordens de Serviço</h1>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Número</th>
      <th>Data</th>
      <th>Destino</th>
      <th>Guia</th>
      <th>Motorista</th>
      <th>Veículo</th>
      <th>Observações</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @service_orders.each do |service_order| %>
      <tr>
        <td><%= service_order.id %></td>
        <td><%= service_order.data %></td>
        <td><%= service_order.destination.description %></td>
        <td><%= service_order.tourguide.sname %></td>
        <td><%= service_order.driver.sname %></td>
        <td><%= service_order.vehicle.license %></td>
        <td><%= service_order.sobservacoes %></td>
        <td><%= link_to 'Show', service_order %></td>
        <td><%= link_to 'Edit', edit_service_order_path(service_order) %></td>
        <td><%= link_to 'Destroy', service_order, method: :delete, data: { confirm: 'Are you sure?' } %></td>
        </tr>
    <% end %>
  </tbody>
</table>

<br>
<%= link_to 'New Service Order', new_service_order_path %>
