
<h1>Veículos</h1>
<%= ultimo_registro(Vehicle) %>
<%= render "shared/pesquisa", url: vehicles_path, dica: "Código, placa, marca, modelo, renavam, cidade…", total: @vehicles.size %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Código</th>
      <th>Placas</th>
      <th>Marca</th>
      <th>Modelo</th>
      <th>Ano</th>
      <th>Cor</th>
      <th>Cidade</th>
      <th>UF</th>
      <th>Observações</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @vehicles.each do |vehicle| %>
      <tr>
        <td><%= vehicle.id %></td>
        <td><%= vehicle.license %></td>
        <td><%= vehicle.brand %></td>
        <td><%= vehicle.smodel %></td>
        <td><%= vehicle.year %></td>
        <td><%= vehicle.color %></td>
        <td><%= vehicle.city %></td>
        <td><%= vehicle.state.uf %></td>
        <td><%= vehicle.comments %></td>
        <td><%= link_to 'Exibir', vehicle %></td>
        <td><%= link_to 'Editar', edit_vehicle_path(vehicle) %></td>
        <td><%= link_to 'Excluir', vehicle, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo', new_vehicle_path %>
