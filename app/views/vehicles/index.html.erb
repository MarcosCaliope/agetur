
<h1>Veículos</h1>
<%= ultimo_registro(Vehicle) %>
<%= render "shared/pesquisa", url: vehicles_path, dica: "Código, placa, marca, modelo, renavam, cidade…", total: @vehicles.size %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Código</th>
      <th>Placas</th>
      <th>Marca</th>
      <th>Modelo</th>
      <th>Ano</th>
      <th>Cor</th>
      <th>Cidade</th>
      <th>UF</th>
      <th>Observações</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @vehicles.each do |vehicle| %>
      <tr>
        <td><%= vehicle.id %></td>
        <td><%= vehicle.license %></td>
        <td><%= vehicle.brand %></td>
        <td><%= vehicle.smodel %></td>
        <td><%= vehicle.year %></td>
        <td><%= vehicle.color %></td>
        <td><%= vehicle.city %></td>
        <td><%= vehicle.state.uf %></td>
        <td><%= vehicle.comments %></td>
        <td class="text-nowrap">
          <%= link_icone 'eye', 'Exibir', vehicle %>
          <%= link_icone 'pencil', 'Editar', edit_vehicle_path(vehicle), class: 'ml-2' %>
          <%= link_icone 'trash', 'Excluir', vehicle, method: :delete, class: 'ml-2 text-danger', data: { confirm: 'Tem certeza?' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo', new_vehicle_path %>
