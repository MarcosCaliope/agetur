
<h1>Empresa</h1>
<%= ultimo_registro(Company) %>
<%= render "shared/pesquisa", url: companies_path, dica: "Código, nome, CNPJ, cidade…", total: @companies.size %>

<table>
  <thead>
    <tr>
      <th>Código</th>
      <th>Nome</th>
      <th>CNPJ</th>
      <th>Endereço</th>
      <th>Telefone</th>
      <th>Cidade</th>
      <th>Estado</th>
      <th>Modelo da OS</th>
      <th>OS dupla</th>
      <th>E-mail</th>
      <th>Site</th>
      <th>Logo do formulário</th>
      <th>Logo de entrada</th>
      <th>Retorno</th>
      <th>Exibir cancelados na OS</th>
      <th>Exibir cancelados no relatório</th>
      <th>Exibir repasse na OS</th>
      <th>Incluir CHD no cálculo</th>
      <th>Observações</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @companies.each do |company| %>
      <tr>
        <td><%= company.id %></td>
        <td><%= company.name %></td>
        <td><%= company.cnpj %></td>
        <td><%= company.address %></td>
        <td><%= company.phone %></td>
        <td><%= company.city %></td>
        <td><%= company.state.uf %></td>
        <td><%= SorderExportPdf.modelo_da(company) %></td>
        <td><%= sim_nao(company.os_dupla?) %></td>
        <td><%= company.email %></td>
        <td><%= company.site %></td>
        <td><%= company_logo_tag company, :formulario, height: 25 %></td>
        <td><%= company_logo_tag company, :entrada, height: 25 %></td>

        <td><%= company.iretorno %></td>
        <td><%= sim_nao(company.exibir_cancelados_na_os?) %></td>
        <td><%= sim_nao(company.exibir_cancelados_no_relatorio?) %></td>
        <td><%= sim_nao(company.exibir_repasse_na_os?) %></td>
        <td><%= sim_nao(company.incluir_chd_no_calculo?) %></td>
        <td><%= company.comments %></td>
        <td class="text-nowrap">
          <%= link_icone 'eye', 'Exibir', company %>
          <%= link_icone 'pencil', 'Editar', edit_company_path(company), class: 'ml-2' %>
          <%= link_icone 'trash', 'Excluir', company, method: :delete, class: 'ml-2 text-danger', data: { confirm: 'Tem certeza?' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Nova Empresa', new_company_path %>
