
<h1>Empresa</h1>
<%= ultimo_registro(Company) %>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>CNPJ</th>
      <th>Endereço</th>
      <th>Telefone</th>
      <th>Cidade</th>
      <th>Estado</th>
      <th>Modelo da OS</th>
      <th>OS dupla</th>
      <th>E-mail</th>
      <th>Site</th>
      <th>Logo do formulário</th>
      <th>Logo de entrada</th>
      <th>Retorno</th>
      <th>Exibir cancelados na OS</th>
      <th>Exibir cancelados no relatório</th>
      <th>Exibir repasse na OS</th>
      <th>Incluir CHD no cálculo</th>
      <th>Observações</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @companies.each do |company| %>
      <tr>
        <td><%= company.name %></td>
        <td><%= company.cnpj %></td>
        <td><%= company.address %></td>
        <td><%= company.phone %></td>
        <td><%= company.city %></td>
        <td><%= company.state.uf %></td>
        <td><%= company.osmodel %></td>
        <td><%= company.osdupla %></td>
        <td><%= company.email %></td>
        <td><%= company.site %></td>
        <td><%= company_logo_tag company, :formulario, height: 25 %></td>
        <td><%= company_logo_tag company, :entrada, height: 25 %></td>

        <td><%= company.iretorno %></td>
        <td><%= company.osshowcan %></td>
        <td><%= company.osshowcanrel %></td>
        <td><%= company.osshowrep %></td>
        <td><%= company.osincludechdcalc %></td>
        <td><%= company.comments %></td>
        <td><%= link_to 'Exibir', company %></td>
        <td><%= link_to 'Editar', edit_company_path(company) %></td>
        <td><%= link_to 'Excluir', company, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Nova Empresa', new_company_path %>
