
<p>
  <strong>Nome:</strong>
  <%= @company.name %>
</p>

<p>
  <strong>Nome reduzido:</strong>
  <%= @company.short_name %>
</p>

<p>
  <strong>CNPJ:</strong>
  <%= @company.cnpj %>
</p>

<p>
  <strong>Inscrição estadual (CGF):</strong>
  <%= @company.state_registration %>
</p>

<p>
  <strong>Endereço:</strong>
  <%= @company.address %>
</p>

<p>
  <strong>Telefone:</strong>
  <%= @company.phone %>
</p>

<p>
  <strong>Cidade:</strong>
  <%= @company.city %>
</p>

<p>
  <strong>Estado:</strong>
  <%= @company.state&.uf %>
</p>

<p>
  <strong>Modelo da OS:</strong>
  <%= SorderExportPdf::NOMES[SorderExportPdf.modelo_da(@company)] %>
</p>

<p>
  <strong>OS dupla:</strong>
  <%= sim_nao(@company.os_dupla?) %>
</p>

<p>
  <strong>E-mail:</strong>
  <%= @company.email %>
</p>

<p>
  <strong>Site:</strong>
  <%= @company.site %>
</p>

<p>
  <strong>Logo do formulário:</strong>
  <%= company_logo_tag(@company, :formulario, height: 80) || "Nenhum" %>
</p>

<p>
  <strong>Logo de entrada:</strong>
  <%= company_logo_tag(@company, :entrada, height: 80) || "Nenhum" %>
</p>

<p>
  <strong>Retorno:</strong>
  <%= @company.iretorno %>
</p>

<p>
  <strong>Exibir cancelados na OS:</strong>
  <%= sim_nao(@company.exibir_cancelados_na_os?) %>
</p>

<p>
  <strong>Exibir cancelados no relatório:</strong>
  <%= sim_nao(@company.exibir_cancelados_no_relatorio?) %>
</p>

<p>
  <strong>Exibir repasse na OS:</strong>
  <%= sim_nao(@company.exibir_repasse_na_os?) %>
</p>

<p>
  <strong>Incluir CHD no cálculo:</strong>
  <%= sim_nao(@company.incluir_chd_no_calculo?) %>
</p>

<p>
  <strong>Observações:</strong>
  <%= @company.comments %>
</p>

<%= link_to 'Editar', edit_company_path(@company) %> |
<%= link_to 'Voltar', companies_path %>
