<h1>Caixa</h1>

<%= form_with url: cash_entries_path, method: :get, local: true, class: "form-inline mb-3 no-print" do %>
  <%= label_tag :inicio, "De", class: "mr-1" %>
  <%= date_field_tag :inicio, @inicio, class: "form-control form-control-sm mr-2" %>
  <%= label_tag :fim, "até", class: "mr-1" %>
  <%= date_field_tag :fim, @fim, class: "form-control form-control-sm mr-2" %>
  <%= submit_tag "Mostrar", name: nil, class: "btn btn-primary btn-sm mr-2" %>
  <%= link_to "Hoje", cash_entries_path, class: "btn btn-outline-secondary btn-sm mr-2" %>
  <%= link_to "Novo lançamento", new_cash_entry_path, class: "btn btn-success btn-sm mr-2" %>
  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="print()">Imprimir</button>
<% end %>

<p class="text-muted"><%= @inicio == @fim ? l(@inicio) : "#{l(@inicio)} a #{l(@fim)}" %></p>

<div class="d-flex flex-wrap text-center mb-3" id="caixa-resumo">
  <% [["Saldo anterior", @saldo_anterior], ["Entradas", @entradas], ["Saídas", -@saidas],
      ["Saldo final", @saldo_anterior + @entradas - @saidas]].each do |rotulo, valor| %>
    <div class="mr-4 mb-2">
      <div class="h5 mb-0 <%= 'text-danger' if valor.negative? %>"><%= number_to_currency(valor) %></div>
      <div class="text-muted small"><%= rotulo %></div>
    </div>
  <% end %>
</div>

<table class="table table-sm table-hover">
  <thead>
    <tr>
      <th>Nº</th>
      <th>Data</th>
      <th>Categoria</th>
      <th>Descrição</th>
      <th>Forma</th>
      <th class="text-right">Entrada</th>
      <th class="text-right">Saída</th>
      <th>Usuário</th>
      <th class="no-print"></th>
    </tr>
  </thead>
  <tbody>
    <% @lancamentos.each do |lancamento| %>
      <tr>
        <td><%= lancamento.id %></td>
        <td><%= l(lancamento.data) %></td>
        <td><%= lancamento.categoria %></td>
        <td>
          <%= lancamento.descricao %>
          <% if lancamento.sorder_id %>· <%= link_to "OS #{lancamento.sorder_id}", sorder_path(lancamento.sorder_id) %><% end %>
        </td>
        <td><%= lancamento.nome_forma %></td>
        <td class="text-right"><%= number_to_currency(lancamento.valor) if lancamento.entrada? %></td>
        <td class="text-right text-danger"><%= number_to_currency(lancamento.valor) unless lancamento.entrada? %></td>
        <td><%= lancamento.usuario %></td>
        <td class="no-print text-nowrap">
          <% if lancamento.pagamento %>
            <%= link_to "Recebimento", sorder_item_recebimentos_path(lancamento.pagamento.sorder_item_id) %>
          <% elsif lancamento.payable %>
            <%= link_to "Conta", payables_path(situacao: "pagas", busca: lancamento.payable.descricao) %>
          <% else %>
            <%= link_to "Editar", edit_cash_entry_path(lancamento) %>
            <%= link_to "Excluir", lancamento, method: :delete, data: { confirm: "Tem certeza?" } %>
          <% end %>
        </td>
      </tr>
    <% end %>
    <% if @lancamentos.empty? %>
      <tr><td colspan="9" class="text-muted">Nenhum lançamento no período.</td></tr>
    <% end %>
  </tbody>
</table>

<% if @por_forma.any? %>
  <h2 class="h6">Por forma de pagamento</h2>
  <table class="table table-sm w-auto">
    <thead><tr><th>Forma</th><th class="text-right">Entradas</th><th class="text-right">Saídas</th></tr></thead>
    <tbody>
      <% CashEntry::FORMAS.each do |forma, nome| %>
        <% entradas, saidas = @por_forma[[forma, "E"]], @por_forma[[forma, "S"]] %>
        <% next unless entradas || saidas %>
        <tr>
          <td><%= nome %></td>
          <td class="text-right"><%= number_to_currency(entradas.to_f) %></td>
          <td class="text-right text-danger"><%= number_to_currency(saidas.to_f) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
