
<h1>Motoristas</h1>
<%= ultimo_registro(Driver) %>
<%= render "shared/pesquisa", url: drivers_path, dica: "Código, nome, nome reduzido, CPF/CNPJ, telefone, cidade…", total: @drivers.size %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nome</th>
      <th>Nome reduzido</th>
      <th>Telefone</th>
      <th>Contato</th>
      <th>Cidade</th>
      
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @drivers.each do |driver| %>
      <tr>
        <td><%= driver.id %></td>
        <td><%= driver.sname %></td>
        <td><%= driver.short_name %></td>
        <td><%= driver.phone %></td>
        <td><%= driver.contact %></td>
        <td><%= [driver.city, driver.state&.uf].compact_blank.join(" / ") %></td>
        <td class="text-nowrap">
          <%= link_icone 'eye', 'Exibir', driver %>
          <%= link_icone 'pencil', 'Editar', edit_driver_path(driver), class: 'ml-2' %>
          <%= link_icone 'trash', 'Excluir', driver, method: :delete, class: 'ml-2 text-danger', data: { confirm: 'Tem certeza?' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Motorista', new_driver_path %>
