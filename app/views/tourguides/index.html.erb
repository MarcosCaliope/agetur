
<h1>Guias</h1>
<%= ultimo_registro(Tourguide) %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Nome</th>
      <th>Nome reduzido</th>
      <th>Telefone</th>
      <th>Contato</th>
      <th>Cidade</th>
      
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tourguides.each do |tourguide| %>
      <tr>
        <td><%= tourguide.sname %></td>
        <td><%= tourguide.short_name %></td>
        <td><%= tourguide.phone %></td>
        <td><%= tourguide.contact %></td>
        <td><%= [tourguide.city, tourguide.state&.uf].compact_blank.join(" / ") %></td>
        <td><%= link_to 'Exibir', tourguide %></td>
        <td><%= link_to 'Editar', edit_tourguide_path(tourguide) %></td>
        <td><%= link_to 'Excluir', tourguide, method: :delete, data: { confirm: 'Tem certeza?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Guia', new_tourguide_path %>
