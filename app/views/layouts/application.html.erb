<!DOCTYPE html>
<html>
  <head>
    <title>Agetur</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <nav class="no-print mb-3 d-flex justify-content-between align-items-center">
      <%= link_to 'Início', root_path %>
      <%= render 'layouts/empresa_atual' %>
    </nav>
    <%= render 'layouts/flash' %>
    <%= yield %>
  </body>
</html>
