<!DOCTYPE html>
<html>
  <head>
    <title>Agetur — Administração</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag    '/templates/gentelella/vendors/font-awesome/css/font-awesome.min.css' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <main class="container py-4">
      <nav class="no-print d-flex flex-wrap justify-content-between align-items-center border-bottom pb-2 mb-4">
        <div>
          <%= link_to 'Início', root_path, class: "mr-3" %>
          <%= link_to 'Administração', admins_backoffice_welcome_index_path, class: "mr-3" %>
          <%= link_to 'Usuários', admins_backoffice_users_path %>
        </div>
        <div class="text-muted small">
          <%= render 'layouts/empresa_atual' %> ·
          <%= current_admin.email %> · <%= link_to 'Minha senha', minha_senha_path %> · <%= link_to 'Sair', destroy_admin_session_path, method: :delete %>
        </div>
      </nav>
      <%= render 'layouts/flash' %>
      <%= yield %>
    </main>
  </body>
</html>
