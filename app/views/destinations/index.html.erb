
<h1>Roteiros</h1>
<%= ultimo_registro(Destination) %>
<%= render "shared/pesquisa", url: destinations_path, dica: "Código ou descrição do roteiro…", total: @destinations.size %>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nome</th>
      <th>Distancia/Km</th>
      <th>Valor</th>
      <th>Valor CHD</th>
      <th>NET</th>
      <th>NETC HD</th>
      <th>Cartão</th>
      <th>Cartão CHD</th>
      <th>UF</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @destinations.each do |destination| %>
      <tr>
        <td><%= destination.id %></td>
        <td><%= destination.description %></td>
        <td><%= destination.distance %></td>
        <td><%= destination.valuenormal %></td>
        <td><%= destination.valuenormalchd %></td>
        <td><%= destination.valuenet %></td>
        <td><%= destination.valuenetchd %></td>
        <td><%= destination.valuecard %></td>
        <td><%= destination.valuecardchd %></td>
        <td><%= destination.state.uf %></td>
        <td class="text-nowrap">
          <%= link_icone 'eye', 'Exibir', destination %>
          <%= link_icone 'pencil', 'Editar', edit_destination_path(destination), class: 'ml-2' %>
          <%= link_icone 'trash', 'Excluir', destination, method: :delete, class: 'ml-2 text-danger', data: { confirm: 'Tem certeza?' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'Novo Roteiro', new_destination_path %>
