<%= form_with(model: pickup_time, local: true) do |form| %>
  <%= render "shared/erros", registro: pickup_time %>
  <div class="form-row">
    <div class="form-group col-md-5">
      <%= form.label :hotel_id %>
      <%= form.select :hotel_id, @hotel_options, { include_blank: "Selecione" }, class: "form-control" %>
    </div>
    <div class="form-group col-md-5">
      <%= form.label :destination_id %>
      <%= form.select :destination_id, @destination_options, { include_blank: "Selecione" }, class: "form-control" %>
    </div>
    <div class="form-group col-md-2">
      <%= form.label :hora %>
      <%= form.time_field :hora, class: "form-control" %>
    </div>
  </div>
  <%= form.submit class: "btn btn-primary" %>
<% end %>
