# Copy to .env (ignored by git) and adjust. Loaded by dotenv-rails in
# development and test; in production set these as real environment variables.

# PostgreSQL (config/database.yml)
AGETUR_DATABASE_HOST=localhost
AGETUR_DATABASE_USERNAME=agetur
AGETUR_DATABASE_PASSWORD=

# Legacy SISTGER SQL Server, read by the Manutenção > Importar do SISTGER screen.
# Each SISTGER_DB_* setting left unset falls back to the Windows registry key the
# old SISTGER client uses (HKCU\SOFTWARE\VB and VBA Program Settings\oServico\BANCO_DE_DADOS),
# read through reg.exe when running under WSL/Windows. A named instance from
# the registry (mynt\sqlexpress) needs the SQL Browser service; set HOST and
# PORT to connect directly instead. SISTGER_DB_REGISTRO=off ignores the registry.
SISTGER_DB_HOST=
SISTGER_DB_PORT=
# SISTGER_DB_NAME=sistger
# SISTGER_DB_USERNAME=
# SISTGER_DB_PASSWORD=
# SQL Server 2014 without updates only speaks TLS 1.0, which current
# FreeTDS/OpenSSL refuse. "off" connects without TLS (login and data travel
# unencrypted); prefer updating the server and leaving this empty.
SISTGER_DB_ENCRYPTION=
